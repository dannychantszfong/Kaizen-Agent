# Copy to .env and fill in. .env is gitignored and never baked into the image.
# Provider API keys — set at least the one for the default model's provider
# (DeepSeek). Unset providers are simply unavailable to the agent (no crash).
# These are read by docker compose (containment/docker-compose.yml) via
#   docker compose --env-file .env -f containment/docker-compose.yml up --build

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
